# ============================================================================
# LaunchLoop AI — Backend Environment Template (.env.example)
# DO NOT PUT REAL SECRETS IN THIS FILE.
# Copy to backend/.env and replace placeholders with your actual configuration.
# ============================================================================

# Environment: "development" or "production"
ENVIRONMENT=development
PORT=8000
LOG_LEVEL=INFO

# Allowed CORS Origins (comma-separated, no trailing slash)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase Configuration
# Obtain from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# AI Provider Configuration (Google Gemini)
# Obtain from: https://aistudio.google.com/app/apikey
DEFAULT_AI_PROVIDER=gemini
GEMINI_API_KEY=your-google-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# Development / Evaluator Demo Secret (DISABLED in production)
# Allows temporary PIN/Header authentication during live offline evaluation
ADMIN_DEMO_SECRET=dev-demo-admin-passkey-change-me
